# Copy this file to .env (backend) and fill in real values for anything beyond local dev.
# Never commit a real .env file.

# --- Database (docker-compose reads DB_NAME/DB_USERNAME/DB_PASSWORD too) ---
DB_NAME=medisphere
DB_USERNAME=medisphere
DB_PASSWORD=medisphere
DB_URL=jdbc:postgresql://localhost:5432/medisphere

# --- Security ---
# Generate a real 256-bit+ secret for anything beyond local dev, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-this-development-only-secret-key-please-override-in-env-min-256-bits
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Seed data ---
# Set to false once you have real hospital data loaded, to avoid demo accounts in production.
SEED_ENABLED=true

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
